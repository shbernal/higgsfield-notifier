{
  "manifest_version": 3,
  "name": "Higgsfield Generation Notifier",
  "version": "1.5.0",
  "description": "Get notified the moment a Higgsfield generation finishes or fails: video, image, audio, 3D. Optional phone push via ntfy.",
  "permissions": ["notifications", "storage"],
  "host_permissions": ["https://higgsfield.ai/*", "https://ntfy.sh/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Higgsfield Notifier",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://higgsfield.ai/*"],
      "js": ["sounds.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://higgsfield.ai/*"],
      "js": ["stream.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
