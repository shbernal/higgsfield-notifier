{
  "name": "higgsfield-notifier",
  "version": "1.4.0",
  "private": true,
  "description": "Browser extension that notifies you when a Higgsfield generation finishes or fails.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "package": "web-ext build --source-dir extension --artifacts-dir release --overwrite-dest"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "web-ext": "^10.8.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
